# Copy to .env.local. "dev" talks to the local API with a fake user; "firebase" uses anonymous sign-in + App Check.
VITE_API_BASE=http://localhost:8080
VITE_AUTH_MODE=dev
VITE_AUTO_SHUTTER_SCORE=0.8
VITE_AUTO_SHUTTER_HOLD_MS=1200
VITE_MAX_UPLOAD_EDGE_PX=2048
# firebase mode only
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Farther than this many metres from the spot, the visitor sees a gentle notice (CLAUDE.md leaves the value open)
VITE_NEAR_SPOT_M=100
