# Copy to .env.local. "dev" = fake admin login against the local API; "firebase" = Google / email sign-in.
VITE_API_BASE=http://localhost:8080
VITE_AUTH_MODE=dev
VITE_DEV_SITE_IDS=site1
VITE_GOOGLE_MAPS_API_KEY=
# firebase mode only
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
